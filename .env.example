NODE_ENV=development
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
PUBLIC_BASE_URL=https://orderpulse.baodishan.com

# Development only. Production uses the corresponding *_FILE variables.
TESLA_CLIENT_ID=replace-me
TESLA_CLIENT_SECRET=replace-me
TOKEN_ENCRYPTION_KEY=replace-with-32-random-bytes-base64
ADMIN_USERNAME=orderpulse
ADMIN_PASSWORD=replace-with-at-least-16-random-characters

TESLA_FLEET_BASE_URL=https://fleet-api.prd.na.vn.cloud.tesla.com
TESLA_AUTHORIZATION_URL=https://auth.tesla.com/oauth2/v3/authorize
TESLA_TOKEN_URL=https://fleet-auth.prd.vn.cloud.tesla.com/oauth2/v3/token
TESLA_OIDC_ISSUER=https://auth.tesla.com/oauth2/v3/nts
TESLA_JWKS_URL=https://auth.tesla.com/oauth2/v3/discovery/thirdparty/keys
TESLA_SCOPES=openid offline_access user_data vehicle_device_data
TESLA_PUBLIC_KEY_FILE=./public/.well-known/appspecific/com.tesla.3p.public-key.pem

# Disabled until Tesla Billing Limit is configured and the first baseline is reviewed.
ORDER_POLLING_ENABLED=false
ORDER_POLL_INTERVAL_SECONDS=1800
ORDER_POLL_JITTER_SECONDS=60
ORDER_MISSING_THRESHOLD=3

# A one-time code is valid for 1 hour. The device credential has no matching TTL.
MOBILE_PAIRING_TTL_SECONDS=3600

# Keep disabled until the Apple Push Notifications key is mounted on the NAS.
APNS_ENABLED=false
APNS_ENVIRONMENT=sandbox
APNS_KEY_ID=replace-with-apple-key-id
APNS_TEAM_ID=replace-with-apple-team-id
APNS_TOPIC=com.baodishan.orderpulse
APNS_PRIVATE_KEY_FILE=./secrets/apns_private_key.p8
